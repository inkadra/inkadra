{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "TZ",
        "CI",
        "INKADRA_TEST_MEDIA_TOOLS",
        "INKADRA_TEST_S3",
        "INKADRA_COVERAGE",
        "S3_TEST_*",
        "COLLAB_SIM_DURATION_MS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
