# Copy to .env next to compose.yaml and fill in. Never commit the real .env.
# Every setting is explained in docs/self-hosting/configuration.md.

# Address people use to reach Inkadra, as seen through your reverse proxy (no trailing slash).
PUBLIC_URL=https://inkadra.example.com

# Random secret used to sign sessions. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Password of the bundled Postgres. Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Optional
# INKADRA_TAG=latest      # image tag: a version such as 0.4.0 (recommended), or edge for the latest build of main
# INSTANCE_NAME=Studio
# REGISTRATION=invite      # invite (default) or open
# LOG_LEVEL=info
# INKADRA_PORT=3000        # host port published by compose
# INKADRA_BIND=127.0.0.1   # 0.0.0.0 if the reverse proxy runs on another host
# TRUST_PROXY=loopback,linklocal,uniquelocal   # peers allowed to set X-Forwarded-For
# UPLOAD_MAX_SIZE=20GB     # largest upload; 0 for no limit
# HEIC_PREVIEWS=true       # false to skip decoding iPhone HEIC photos
# RAW_PREVIEWS=true        # -media image: thumbnails of camera RAW files from their embedded JPEG
# OFFICE_PREVIEWS=false    # optional Linux Office worker: LibreOffice + bubblewrap + prlimit
# PDF_PREVIEWS=true        # -media image: thumbnails of page 1 of PDFs and their page count
# VIDEO_PROXIES=true       # -media image: playable MP4 copies of ProRes, MKV, AVI, MXF, HEVC
# VIDEO_PROXY_HWACCEL=auto # -media image: auto, nvenc, qsv, vaapi or none (see deploy/compose.vaapi.yaml)
# VIDEO_PROXY_VAAPI_DEVICE=/dev/dri/renderD128
# MAPS=true                # map pictures of map cards and GPX files, fetched once by the server
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_GEOCODER_URL=        # Nominatim-compatible /search to look up addresses; empty = off
# RENDER_GID=              # deploy/compose.vaapi.yaml: group of /dev/dri/renderD128 on the host

# Sign-in (see docs/self-hosting/sign-in.md). Leave empty what you do not use.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS=               # e.g. studio.it; empty = any Google account
# OIDC_NAME=Authentik                   # label of the button
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/inkadra/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=                          # space-separated; openid email profile by default
# OIDC_TRUST_EMAIL=false                # true links OIDC sign-ins to accounts with the same email
# SMTP_URL=smtp://user:password@smtp.example.com:587   # invitations and sign-in links by email
# MAIL_FROM=Inkadra <inkadra@example.com>
# CLIPPER_EXTENSION_IDS=                # ids of self-built browser clippers that may sign in
# OIDC_ALLOWED_DOMAINS=                 # e.g. studio.it; empty = any verified OIDC account

# Data in host folders instead of Docker volumes (see docs/self-hosting/storage.md)
# INKADRA_DATA=/srv/inkadra/data          # given to uid 1000 at startup
# POSTGRES_DATA=/srv/inkadra/postgres     # owned by uid 70; PostgreSQL 18 writes to 18/docker inside
# Installs from before PostgreSQL 18: docs/self-hosting/upgrades.md#upgrading-to-postgresql-18

# Files in S3: with deploy/compose.s3.yaml (your bucket) or deploy/compose.rustfs.yaml (bundled)
# S3_ENDPOINT=https://s3.example.com      # empty for AWS
# S3_REGION=us-east-1
# S3_BUCKET=inkadra
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false               # true for self-hosted stores

# Bundled reverse proxy (deploy/proxy/<caddy|traefik|nginx>/compose.yaml)
# INKADRA_DOMAIN=inkadra.example.com      # the host of PUBLIC_URL
# INKADRA_COLLAB_UPSTREAM=collab:3001     # split mode, Caddy and Nginx
# ACME_EMAIL=you@example.com              # Traefik, for Let's Encrypt
# TRAEFIK_CERTRESOLVER=                   # Traefik certresolver that gets the certificate
# NGINX_CERTS=./certs                     # Nginx: folder with fullchain.pem and privkey.pem

# Browser security headers (see docs/self-hosting/configuration.md#browser-security-headers)
# CSP_ENFORCE=false                     # false: Content-Security-Policy is report-only; true enforces it
# CSP_REPORT_URI=https://reports.example.com/csp   # absolute address for CSP violation reports
# HSTS_ENABLED=false                    # true sends Strict-Transport-Security, with an https PUBLIC_URL
