# Copy to .env next to compose.yaml and fill in. Never commit the real .env.
# Every setting is explained in docs/self-hosting/configuration.md.

# Address people use to reach Inkadra, as seen through your reverse proxy (no trailing slash).
PUBLIC_URL=https://inkadra.example.com

# Random secret used to sign sessions. Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Previous encryption key during rotation; see docs/self-hosting/configuration.md.
# AUTH_SECRET_PREVIOUS=

# Password of the bundled Postgres. Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Password of the bundled Valkey (queues and sign-in limits), letters and digits only.
# Generate one with: openssl rand -hex 32. Empty: Valkey asks for none, as before 0.10.
VALKEY_PASSWORD=

# Optional
# INKADRA_TAG=latest      # image tag: pin a version such as 0.9.0 (recommended: migrations cannot be undone; 0.9.0-media adds video, PDF and RAW previews), or edge for the latest build of main
# INSTANCE_NAME=Studio
# REGISTRATION=invite      # invite (default), open or closed
# LOG_LEVEL=info
# LOG_CLIENT_IP=false     # true writes client addresses in request logs (personal data)
# LOG_MAX_SIZE=20m         # container logs: size of one file, and how many are kept
# LOG_MAX_FILES=5
# METRICS_TOKEN=           # 32+ characters: turns on GET /metrics for Prometheus, with this bearer token
# INKADRA_MEM_LIMIT=6g     # container limits (docs/self-hosting/configuration.md#resource-limits)
# INKADRA_PORT=3000        # host port published by compose
# INKADRA_BIND=127.0.0.1   # 0.0.0.0 if the reverse proxy runs on another host
# TRUST_PROXY=192.168.1.10  # only your reverse proxy's address (docs/self-hosting/configuration.md#trust_proxy);
#                           # unset: loopback and every private network. The bundled proxies set their own.
# UPLOAD_MAX_SIZE=20GB     # largest upload; 0 for no limit
# STORAGE_LIMIT=           # space of the whole instance (500GB); set, it locks the field in Settings
# STORAGE_LIMIT_PER_USER=  # default space of each person (5GB); set, it locks the field in Settings
# BOARD_MAX_STATE_BYTES=64MB # encoded Yjs state per board: bytes or a size (64MB = 64 MiB)
# BOARD_MAX_ELEMENTS=20000   # elements per board, positive integer
# HEIC_PREVIEWS=true       # false to skip decoding iPhone HEIC photos
# RAW_PREVIEWS=true        # thumbnails of camera RAW files from their embedded JPEG
# OFFICE_PREVIEWS=false    # optional Linux Office worker: LibreOffice + bubblewrap + prlimit
# PDF_PREVIEWS=true        # thumbnails of page 1 of PDFs and their page count
# VIDEO_PROXIES=true       # playable MP4 copies of ProRes, MKV, AVI, MXF, HEVC
# VIDEO_PROXY_HWACCEL=auto # auto, nvenc, qsv, vaapi or none (see deploy/compose.vaapi.yaml)
# VIDEO_PROXY_VAAPI_DEVICE=/dev/dri/renderD128
# PRODUCTION_BOARD_MOVE=true # true or false only; false skips moving shooting days to Production boards at start (see docs/self-hosting/upgrades.md)
# MAPS=true                # map pictures of map cards and GPX files, fetched once by the server
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_SATELLITE_TILE_URL= # Optional http(s) template with {z}/{x}/{y}; empty hides the selector
# MAP_SATELLITE_TILE_ATTRIBUTION=Satellite
# MAP_GEOCODER_URL=        # Nominatim-compatible /search to look up addresses; empty = off
# RENDER_GID=              # deploy/compose.vaapi.yaml: group of /dev/dri/renderD128 on the host

# Sign-in (see docs/self-hosting/sign-in.md). Leave empty what you do not use.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS=               # e.g. studio.it; empty = any Google account
# OIDC_NAME=Authentik                   # label of the button
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/inkadra/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=                          # space-separated; openid email profile by default
# OIDC_TRUST_EMAIL=false                # true links OIDC sign-ins to accounts with the same email
# SMTP_URL=smtp://user:password@smtp.example.com:587   # invitations and sign-in links by email
# MAIL_FROM=Inkadra <inkadra@example.com>
# CLIPPER_EXTENSION_IDS=                # ids of self-built browser clippers that may sign in
# OIDC_ALLOWED_DOMAINS=                 # e.g. studio.it; empty = any verified OIDC account

# Data in host folders instead of Docker volumes, on one disk or on several; back them all up
# (see docs/self-hosting/storage.md#data-on-different-disks)
# INKADRA_DATA=/srv/inkadra/data          # given to uid 1000 at startup
# POSTGRES_DATA=/srv/inkadra/postgres     # owned by uid 70; PostgreSQL 18 writes to 18/docker inside
# VALKEY_DATA=/srv/inkadra/valkey         # the Valkey image gives it to its own user at startup
# Installs from before PostgreSQL 18: docs/self-hosting/upgrades.md#upgrading-to-postgresql-18

# Files in S3: with deploy/compose.s3.yaml (your bucket) or deploy/compose.rustfs.yaml (bundled)
# S3_ENDPOINT=https://s3.example.com      # empty for AWS
# S3_REGION=us-east-1
# S3_BUCKET=inkadra
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false               # true for self-hosted stores

# Bundled reverse proxy (deploy/proxy/<caddy|traefik|nginx>/compose.yaml)
# INKADRA_DOMAIN=inkadra.example.com      # the host of PUBLIC_URL
# INKADRA_COLLAB_UPSTREAM=collab:3001     # split mode, Caddy and Nginx
# ACME_EMAIL=you@example.com              # Traefik, for Let's Encrypt
# TRAEFIK_CERTRESOLVER=                   # Traefik certresolver that gets the certificate
# NGINX_CERTS=./certs                     # Nginx: folder with fullchain.pem and privkey.pem

# Browser security headers (see docs/self-hosting/configuration.md#browser-security-headers)
# CSP_ENFORCE=true                      # true (default) enforces Content-Security-Policy; false only reports
# CSP_REPORT_URI=https://reports.example.com/csp   # absolute address for CSP violation reports
# HSTS_ENABLED=true                     # true (default): Strict-Transport-Security on HTTPS requests, with an https PUBLIC_URL; false turns it off

# Reports from the app go to the Inkadra developers wherever no administrator saved a choice,
# upgraded instances included. Nothing leaves until someone sends a report, after its preview.
# What leaves and how to stop it: docs/self-hosting/README.md#what-leaves-your-server
# Uncomment with an empty value to turn this route off:
# FEEDBACK_RELAY_URL=
# Your own route instead: fine-grained token, Issues read/write + Metadata read on one private repo.
FEEDBACK_GITHUB_TOKEN=

# A public demo (docs/demo.md, deploy/compose.demo.yaml): "Try the demo" sandboxes, deleted after DEMO_TTL
# DEMO_MODE=false
# DEMO_TTL=1h
# DEMO_STORAGE=100MB
# DEMO_MAX_SANDBOXES=50
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
