{
  "name": "inkadra-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @inkadra/e2e e2e",
    "openapi": "pnpm --filter @inkadra/shared openapi",
    "mock": "pnpm --filter @inkadra/shared mock",
    "db:generate": "pnpm --filter @inkadra/server db:generate",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "^2.11.0",
    "typescript": "^5.9.0"
  }
}
